<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlayContainer"
    android:layout_width="@dimen/overlay_width"
    android:layout_height="@dimen/overlay_height"
    android:background="@drawable/bg_overlay"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/margin_medium"
    android:visibility="gone">

    <TextView
        android:id="@+id/tvOverlayNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.7"
        android:textColor="@color/text_primary"
        android:textSize="52sp"
        android:textStyle="bold"
        tools:text="1" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/margin_medium"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvOverlayChannelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_meta"
            android:textStyle="bold"
            tools:text="Channel Name" />

        <TextView
            android:id="@+id/tvOverlayProgram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.9"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            tools:text="Program Title" />

        <TextView
            android:id="@+id/tvOverlayTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_xsmall"
            android:alpha="0.8"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_time"
            tools:text="20:00 - 21:00" />
    </LinearLayout>

</LinearLayout>
