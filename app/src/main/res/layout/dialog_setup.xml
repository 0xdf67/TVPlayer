<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_dark"
    android:orientation="vertical"
    android:padding="@dimen/margin_medium">

    <TextView
        android:id="@+id/tvSetupTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small"
        android:text="@string/setup_title"
        android:textColor="@color/accent_orange"
        android:textSize="@dimen/text_channel_name"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSetupMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_medium"
        android:text="@string/setup_message"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body" />

    <EditText
        android:id="@+id/etM3uUrl"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="@dimen/margin_small"
        android:background="@drawable/selector_focusable"
        android:hint="@string/setup_m3u_hint"
        android:imeOptions="actionNext"
        android:inputType="textUri"
        android:paddingHorizontal="@dimen/margin_small"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="@dimen/text_meta" />

    <EditText
        android:id="@+id/etEpgUrl"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="@dimen/margin_medium"
        android:background="@drawable/selector_focusable"
        android:hint="@string/setup_xmltv_hint"
        android:imeOptions="actionDone"
        android:inputType="textUri"
        android:paddingHorizontal="@dimen/margin_small"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="@dimen/text_meta" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="@dimen/margin_xsmall"
            android:background="@android:color/transparent"
            android:focusable="true"
            android:paddingHorizontal="@dimen/margin_medium"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_meta" />

        <Button
            android:id="@+id/btnLoad"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_channel_badge"
            android:focusable="true"
            android:paddingHorizontal="@dimen/margin_medium"
            android:text="@string/setup_load"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_meta" />

    </LinearLayout>

</LinearLayout>
